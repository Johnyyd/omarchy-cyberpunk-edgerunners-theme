@define-color background #26173E;
@define-color foreground #46FEEC;
@define-color border alpha(@accent, 0.4);
@define-color accent #FFFF4C;
@define-color fire #ED4BA8;
@define-color panel-tint rgba(2, 179, 241, 0.08);
@define-color panel alpha(@background, 0.4);

window#waybar {
    background: #26173E;
    color: @foreground;
}

.modules-left,
.modules-center,
.modules-right {
    margin: 6px 8px 0;
    padding: 2px 6px;
    background: linear-gradient(to bottom, @panel-tint, @panel);
    border: 1px solid @border;
    border-radius: 12px;
}

#workspaces button.active,
#workspaces button.focused,
#custom-launcher,
#window {
    color: @fire;
}

/* Opaque popups, menus, and tooltips */
tooltip,
menu {
    background: #26173E;
    color: @foreground;
    border: 1px solid @fire;
    border-radius: 8px;
    opacity: 1;
}

tooltip label,
menu label {
    color: @foreground;
}